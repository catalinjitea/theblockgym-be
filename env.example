# ── Netopia Payments ──────────────────────────────────────────────────────────
# Get these from https://admin.netopia-payments.com
NETOPIA_API_KEY=your-api-key-here
NETOPIA_POS_SIGNATURE=your-pos-signature-here
NETOPIA_IS_LIVE=false
# RSA public key from Netopia — wrap in double quotes to preserve newlines
NETOPIA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_KEY_BODY_HERE
-----END PUBLIC KEY-----"

# ── Resend (email) ────────────────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Public URL for the logo used in emails (must be accessible by email clients, not localhost)
EMAIL_LOGO_URL=https://yourdomain.com/logo.png

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-in-production
# Website cookie login (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Mobile app: Bearer access token (minutes) and rotating refresh token (days)
MOBILE_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=60

# ── Push notifications (mobile app) ───────────────────────────────────────────
# Run the reminder/expiry jobs in this process; keep exactly one process with it on
NOTIFICATION_JOBS_ENABLED=true
NOTIFICATION_JOBS_INTERVAL_SECONDS=300
# Only if Enhanced push security is enabled in the Expo project
# EXPO_ACCESS_TOKEN=
